C c54_linefirst
"CAND-54 spec 9.2, amendment L(iii): the archiver stores the archive
 line (seq_cst) BEFORE raising start_offset (seq_cst).  A reader that
 sees the raised boundary must see the raised line: in the single total
 order S, line-store < raise-so < reader's so-load < reader's
 aoff-load, and an sc load reads the last sc store preceding it.
 Forbidden: so reads the raise AND aoff reads the old line.
 (This is what makes max(so, aoff) at the pre-check safe against a
 commit min lowering only so.)"

{
 aoff = 64;
 so = 64;
}

P0 (atomic_int *aoff, atomic_int *so)
{
  atomic_store_explicit(aoff, 128, memory_order_seq_cst);
  atomic_store_explicit(so, 128, memory_order_seq_cst);
}

P1 (atomic_int *so, atomic_int *aoff)
{
  int r0 = atomic_load_explicit(so, memory_order_seq_cst);
  int r1 = atomic_load_explicit(aoff, memory_order_seq_cst);
}

exists (1:r0 = 128 /\ 1:r1 = 64)
